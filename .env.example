# ==============================================================================
# SidelineOS — Beispiel-Umgebungskonfiguration (keine echten Secrets committen!)
# Ersteinrichtung erfolgt deployment-unabhängig ausschließlich über ENV-Variablen.
# ==============================================================================

# Anwendungs-URL & Session-Sicherheit
APP_URL="http://localhost:3000"
SESSION_SECRET="CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET"

# Ersteinrichtung (Bootstrap beim ersten Start ohne UI-Wizard)
INITIAL_SYSADMIN_EMAIL="admin@verein.example"
INITIAL_SYSADMIN_USERNAME="sysadmin"
INITIAL_SYSADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# Aktivierte Module (kommagetrennt: video-analysis,playbook,roster-attendance)
ENABLED_MODULES="video-analysis"

# PostgreSQL (Single Source of Truth für Metadaten, Breakdowns & Rechte)
# Bleibt DATABASE_URL leer, startet im Dev-Modus automatisch ein lokaler PGlite-Fallback.
DATABASE_URL="postgresql://sidelineos:changeme@localhost:5432/sidelineos"
PGLITE_DATA_DIR=""

# S3-kompatibler Object Storage (MinIO, Hetzner Object Storage, Ceph, AWS S3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-central-1"
S3_BUCKET="sidelineos-instance"
S3_ACCESS_KEY="YOUR_S3_ACCESS_KEY"
S3_SECRET_KEY="YOUR_S3_SECRET_KEY"
S3_FORCE_PATH_STYLE="true"

# S3-Garbage-Collector: Schonfrist in Tagen nach Referenzverlust (ref_count = 0)
S3_CLEANUP_RETENTION_DAYS="14"

# E-Mail / SMTP (für Einladungen & Passwort-Zurücksetzung)
SMTP_HOST="smtp.example.org"
SMTP_PORT="587"
SMTP_USER="noreply@verein.example"
SMTP_PASSWORD="YOUR_SMTP_PASSWORD"
SMTP_FROM="SidelineOS <noreply@verein.example>"
SMTP_TLS="true"

# Transcoding-Modus: CLIENT_WASM | LOCAL_FFMPEG | EXTERNAL_WEBHOOK
TRANSCODING_MODE="CLIENT_WASM"

# Core-Version, Plugin-Installer & Update-Checker
CORE_VERSION="0.1.0"
PLUGIN_DATA_DIR=".sidelineos-data/plugins"
DEV_ALLOW_GIT_INSTALL="true"
DISABLE_UPDATE_CHECK="false"
CORE_GITHUB_REPO="sidelineos/sidelineos-core"

# Optional: KI-Suche (Ollama lokal oder Gemini API)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OLLAMA_BASE_URL=""

