# ==============================================================================
# SidelineOS-core v0.2.0 — Beispiel-Umgebungskonfiguration
# Keine echten Secrets in Git committen!
# ==============================================================================

# Anwendungs-URL, Markenname, Sprache & Session-Sicherheit
APP_URL="http://localhost:3000"
APP_BRAND_NAME="SidelineOS"
VITE_APP_BRAND_NAME="SidelineOS"
DEFAULT_LOCALE="de"
SESSION_SECRET=
SESSION_TTL_HOURS="168"

# Ersteinrichtung (erster Sysadmin ohne UI-Wizard)
INITIAL_SYSADMIN_EMAIL=
INITIAL_SYSADMIN_USERNAME=
INITIAL_SYSADMIN_PASSWORD=

# PostgreSQL (Single Source of Truth für Core + isolierte Plugin-Schemas)
# Bleibt DATABASE_URL leer, startet automatisch ein lokaler PGlite-Fallback.
DATABASE_URL=
PGLITE_DATA_DIR=""

# Core-Version, Plugin-Verzeichnis & ENV-Bootstrap für Standard-Plugins
# CORE_BOOTSTRAP_PLUGINS akzeptiert kommagetrennte lokale .tar.gz-Pfade oder https://-Release-URLs
CORE_VERSION="0.2.0"
PLUGIN_DATA_DIR=".sidelineos-data/plugins"
CORE_BOOTSTRAP_PLUGINS=""

# Maximale Dateigröße pro Upload im Storage-Broker in Bytes (Standard: 5 GiB)
MAX_UPLOAD_BYTES="5368709120"

# Nur für Entwicklungs-/Staging-Instanzen: erlaubt das Plugin SidelineOS-dev-git-tools
ALLOW_DEV_PLUGINS="false"
